# ==============================================================================
# NutriVision AI: Git Ignore Rules
# ==============================================================================

# --- Python & Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
venv/
ENV/
env/

# --- Testing & Code Quality ---
.pytest_cache/
*.pytest_cache*
.coverage
htmlcov/
.oxlintrc.cache

# --- Massive Archives & Backups ---
# Prevents accidental commits of multi-hundred MB backup archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak

# --- Node.js & Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime Uploads & Generated Databases ---
# Preserve directory structure with .gitkeep but ignore uploaded test images
backend/uploads/*
!backend/uploads/.gitkeep

# Ignore runtime autonomous agent database & journal files
backend/database/agent_management.db*
*.db-journal
*.sqlite3-journal

# --- IDE, Editor & OS Artifacts ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
OS file name.pdf
